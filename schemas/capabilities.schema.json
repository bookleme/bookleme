{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BookLeme capabilities.json",
  "type": "object",
  "required": ["schema_version", "book_sha256", "extractor", "capabilities"],
  "properties": {
    "schema_version": { "type": "string" },
    "book_sha256": { "type": "string" },
    "extractor": { "type": "string", "enum": ["deterministic-markup", "heuristic", "llm"] },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability_id", "title", "source_id", "span", "ria", "status"],
        "properties": {
          "capability_id": { "type": "string" },
          "title": { "type": "string" },
          "genre_tags": { "type": "array", "items": { "type": "string" } },
          "engine_targets": { "type": "array", "items": { "type": "string" } },
          "figure_refs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^FIG-[0-9]{3}$" },
            "description": "2.0：图注落在本卡 char 区间内时挂接的图 ID"
          },
          "source_id": { "type": "string" },
          "span": {
            "type": "object",
            "required": ["segment_id", "char_start", "char_end"],
            "properties": {
              "chapter": { "type": "string" },
              "section": { "type": "string" },
              "page": { "type": "integer" },
              "segment_id": { "type": "string" },
              "char_start": { "type": "integer" },
              "char_end": { "type": "integer" }
            }
          },
          "ria": {
            "type": "object",
            "required": ["R_quote", "I_rephrase", "A1_author_case", "A2_user_trigger", "A3_steps", "B_not_applicable"],
            "properties": {
              "R_quote": { "type": "string" },
              "I_rephrase": { "type": "string" },
              "A1_author_case": { "type": "string" },
              "A2_user_trigger": { "type": "string" },
              "A3_steps": { "type": "array", "items": { "type": "string" } },
              "B_not_applicable": { "type": "string" }
            }
          },
          "claims": { "type": "array", "items": { "type": "string" } },
          "genre_fields": {
            "type": "object",
            "description": "体裁额外必填字段（plugin.capability_schema.genre_fields），缺失值填「书里没讲」"
          },
          "checks": { "type": "object" },
          "confidence": { "type": "object" },
          "source_tier": {
            "type": "string",
            "enum": ["S", "A", "B", "C"],
            "description": "来源等级（与 provenance_manifest.sources[].tier 一致）；抽取方式的可信度在 confidence.tier"
          },
          "status": { "type": "string", "enum": ["draft", "verified", "rejected"] }
        }
      }
    }
  }
}
