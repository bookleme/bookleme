{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BookLeme figures.json (2.0)",
  "type": "object",
  "required": ["schema_version", "book_sha256", "figures"],
  "properties": {
    "schema_version": { "type": "string" },
    "book_sha256": { "type": "string" },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["figure_id", "source_id", "kind", "caption", "image_file"],
        "properties": {
          "figure_id": { "type": "string", "pattern": "^FIG-[0-9]{3}$" },
          "source_id": { "type": "string" },
          "page": { "type": ["integer", "null"] },
          "kind": { "type": "string", "enum": ["figure", "table", "unlabeled_figure"] },
          "caption": { "type": "string", "maxLength": 150 },
          "char_start": { "type": ["integer", "null"] },
          "char_end": { "type": ["integer", "null"] },
          "anchor_kind": { "type": ["string", "null"], "enum": ["caption", "context", null] },
          "pairing_uncertain": {
            "type": "boolean",
            "description": "同页图注数与位图数不一致时，按序配对只是猜测——如实标注"
          },
          "unlabeled": { "type": "boolean", "description": "该图没有可用图注（只有位图）" },
          "image_file": { "type": ["string", "null"] }
        }
      }
    }
  }
}
