# 可选依赖（仅用于验收双保险，不入库）
.vendor/
.venv/
__pycache__/
*.py[cod]
.DS_Store
.env

# 运行期产物
out/
cache/
logs/
runs/
sources/public/*.json
sessions/

# 用户自备书籍：绝不入库（版权）
evals/cases/user_books/*
!evals/cases/user_books/.gitkeep
*.pdf
*.epub
*.mobi
*.azw3
!.github/**/*.pdf

# 本地运行记录：含本机绝对路径与 run 历史，不入库
state.json
progress.md
ITERATION_LOG.md
